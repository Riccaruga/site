# Timeweb virtual hosting — secrets. Copy to ~/site/.env on server, chmod 600.
# NEVER commit the real ~/site/.env to git.
#
# Server layout:
#   ~/site/repo/        <- git clone -b master https://github.com/Riccaruga/site.git
#   ~/site/public_html/ <- prod copy (rsync from repo)
#   ~/site/venv/        <- python3.10 -m venv venv
#   ~/site/.env         <- THIS file (real values)

# --- Django ---
# Generate once: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-generate-new-secret-key
DJANGO_DEBUG=False
# Tech domain until real domain is bound. Comma-separated if several.
DJANGO_ALLOWED_HOSTS=ct931410.tw1.ru
# Must include scheme. http for now (no SSL), switch to https:// after Let's Encrypt.
DJANGO_CSRF_TRUSTED_ORIGINS=http://ct931410.tw1.ru

# --- MySQL (Timeweb panel -> Databases) ---
DB_NAME=ct931410_DB
DB_USER=ct931410_DB
DB_PASS=change-me
DB_HOST=localhost
DB_PORT=3306

# --- Mail (optional, leave empty = console backend for dev) ---
# Timeweb mailbox SMTP, e.g. smtp.timeweb.ru:587 + TLS
# EMAIL_HOST=smtp.timeweb.ru
# EMAIL_PORT=587
# EMAIL_HOST_USER=noreply@your-domain.ru
# EMAIL_HOST_PASSWORD=change-me
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@your-domain.ru
# CONTACT_EMAIL=artist@example.com
DEFAULT_FROM_EMAIL=noreply@example.com
CONTACT_EMAIL=artist@example.com
